# Szerver konfiguráció
PORT=3000
NODE_ENV=development

# Adatbázis (a docker-compose.yml által indított PostGIS konténerhez)
DATABASE_URL=postgres://moto:moto_dev_pw@localhost:5432/moto_konvoj

# JWT - ÉLES használat előtt kötelező kicserélni!
JWT_SECRET=valtoztasd-meg-egy-hosszu-veletlen-szovegre
JWT_EXPIRES_IN=7d

# Jelszó hash-elés költsége (bcrypt round)
BCRYPT_ROUNDS=10

# CORS: * a fejlesztéshez; élesben a kliens origin-je
CORS_ORIGIN=*
